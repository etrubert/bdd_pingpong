+// =====================================================================
+// PING PANG PARIS — Coach IA : balle flottante (FAB)
+//
+// Affiche une balle de ping-pong en bas à droite, au-dessus de la
+// BottomNav. Au clic, ouvre la fenêtre de chat (CoachChat).
+// =====================================================================
+
+import { useState } from 'react';
+import CoachChat from './CoachChat';
+import { C } from '../theme';
+
+export default function CoachBubble() {
+  const [open, setOpen] = useState(false);
+
+  return (
+    <>
+      <button
+        onClick={() => setOpen(true)}
+        aria-label="Ouvrir Coach Ping"
+        style={{
+          all: 'unset', cursor: 'pointer',
+          position: 'absolute',
+          right: 16,
+          bottom: 94,
+          zIndex: 80,
+          width: 56, height: 56,
+          borderRadius: '50%',
+          background: 'radial-gradient(circle at 35% 30%, #FFFFFF 0%, #F5F6F3 50%, #D8D9D5 100%)',
+          boxShadow: '0 4px 14px rgba(0,0,0,0.40), inset -4px -5px 10px rgba(0,0,0,0.10)',
+          border: `1px solid rgba(0,0,0,0.10)`,
+          display: 'flex', alignItems: 'center', justifyContent: 'center',
+          transition: 'transform 120ms ease',
+        }}
+        onMouseDown={(e) => { e.currentTarget.style.transform = 'scale(0.95)'; }}
+        onMouseUp={(e) => { e.currentTarget.style.transform = 'scale(1)'; }}
+        onMouseLeave={(e) => { e.currentTarget.style.transform = 'scale(1)'; }}
+      >
+        {/* Petit logo coach à l'intérieur de la balle pour distinguer du fond */}
+        <span style={{
+          fontFamily: 'system-ui',
+          fontWeight: 800, fontSize: 22, lineHeight: 1,
+          color: C.streak || '#E64949',
+          textShadow: '0 1px 0 rgba(255,255,255,0.40)',
+          userSelect: 'none',
+        }}>?</span>
+        {/* Petit point d'indication "en ligne" */}
+        <span style={{
+          position: 'absolute', bottom: 3, right: 3,
+          width: 12, height: 12, borderRadius: '50%',
+          background: '#C8E6D2',
+          border: '2px solid #F5F6F3',
+        }} />
+      </button>
+
+      {open && <CoachChat onClose={() => setOpen(false)} />}
+    </>
+  );
+}
