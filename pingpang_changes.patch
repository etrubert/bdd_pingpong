+            fontFamily: fontSans, fontSize: 13, color: C.inkDim, paddingBottom: 6,
+          }}>{current <= 1 ? 'jour' : 'jours d\u2019affilée'}</div>
+        </div>
+
+        <div style={{
+          marginTop: 12, fontFamily: fontSans, fontSize: 12.5, lineHeight: 1.45,
+          color: inPodium ? C.warm : C.inkDim,
